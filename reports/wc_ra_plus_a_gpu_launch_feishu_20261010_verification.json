  "one_targeted_rich_paragraph_changed_all_other_content_preserved": true,
  "old_text": "\u5f53\u524d\u8fdb\u5c55\uff082026-10-10\uff09\uff1a\u52a8\u6001\u6765\u6e90\u611f\u77e5 C/P/D \u666e\u901a\u91c7\u6837\u5b8c\u6574CPU\u5df2\u72ec\u7acb\u9a8c\u6536\uff0c128\u6761\u5b8c\u657436\u6b65\u8def\u5f84\uff0864\u6210\u529f\uff0b64\u672b\u5199\u51fa\u6545\u969c\uff09\u30012368\u4e2a\u6210\u529f\u5f20\u91cf\u91cd\u8bfb\u3001512\u6b21\u72b6\u6001\u6062\u590d\uff0c\u539fRA\u4e0e\u5173\u95edP\u3001CPD\u4e0eA OFF\u5b8c\u6574\u8f68\u8ff9\u76f8\u540c\uff1b\u8fd9\u4e9b\u662fToy\u7ba1\u7ebf\u8bc1\u636e\u3002\u539f\u771f\u5b9eP0\u516b\u8d77\u70b9\u3001\u56db\u6a21\u5f0f\u768432\u6761\u7ecf\u9a8c\u91cf\u7eb2\u6620\u5c04\u53ca16\u6761dense\u63a7\u5236\u5df2\u5168\u90e8\u72ec\u7acb\u91cd\u5efa\uff0c48\u884c\u548c144\u6b21\u4eea\u5668\u5316\u8ba1\u65f6\u4fdd\u7559\u300250%\u8f6e\u6362\u6a21\u5f0f\u7684step12/30\u521b\u5efa\u8bef\u5deefloor\u4e2d\u4f4d0.019671/0.133267\uff0c\u4e58\u539f\u4f20\u64adgain\u540e\u665a/\u65e9\u7ea61.88\uff0c\u63d0\u793a\u5168\u5c40\u5355\u503c\u53ef\u80fd\u9519\u914d\u9636\u6bb5\u98ce\u9669\u3002\u5df2\u524d\u77bb\u767b\u8bb0\u56fa\u5b9astep25\u521b\u5efa\u9636\u6bb5\u5148\u9a8c\uff0c\u5b9e\u9645\u516d\u6761\u5b8c\u657436\u6b65/216\u6b65\u7eaf\u7b56\u7565\u63a7\u5236\u901a\u8fc7\uff1bP\u540eC\u4fdd\u7559\u51fa\u751f\u8d28\u91cf\uff0c\u53ea\u6709\u771f\u5b9eD\u91cd\u7f6e\u3002\u53e6\u6709\u663e\u5f0fsynthetic\u7ed3\u6784\u5bf9\u7167\u53d1\u73b0\uff0c\u539f\u516d\u6b65\u6821\u51c6\u8868\u6309\u771f\u5b9eD\u5e74\u9f84\u67e5\u8be2\uff0c\u53ef\u80fd\u9650\u5236\u65b0P\u5de5\u4f5c\u6765\u6e90\u7684\u5bff\u547d\uff1b\u7f3a\u5931\u5148\u9a8c\u4fdd\u62a4\u4fdd\u6301\uff0c\u5de5\u4f5c\u6765\u6e90\u67e5\u8be2\u5c1a\u672a\u5b89\u88c5\u3002\u4e0b\u4e00\u63a5\u9636\u6bb5\u666e\u901a\u91c7\u6837\u4e0e\u771f\u5b9e\u52a8\u4f5c\u6210\u672c\u3001\u5b8c\u6574\u65b9\u6cd5\u89c6\u9891\uff0c\u4e0d\u589e\u52a0\u975e\u5fc5\u8981\u4eba\u5de5\u8bc4\u5ba1\u3002\u672c\u8f6e\u65b0\u589eGPU0\uff0c\u7d2f\u8ba134.372880296/77.895246590 GPUh\uff0c\u65b048\u7a97\u53e3\u4f5943.522366294\uff1b\u5355\u6b21\u5b8c\u6574\u22644\u81ea\u4e3b\u3001\u4e25\u683c>4\u5177\u4f53\u786e\u8ba4\uff0c\u539fRA\uff0bA\u5b8c\u65745.147707517 GPUh\u56de\u590d\u5f85\u3002\u672a\u628aCPU\u901a\u8fc7\u3001\u7ecf\u9a8cproxy\u6216\u5c40\u90e8\u4fe1\u53f7\u79f0\u4e3a\u7a33\u5b9a\u89c6\u9891\u8d28\u91cf/\u7aef\u5230\u7aef\u52a0\u901f\u7ed3\u679c\u3002",
  "new_text": "\u5f53\u524d\u8fdb\u5c55\uff082026-10-10\uff09\uff1a\u5b8c\u657432\u8def\u5f84 RA\uff0bA \u5361\u5df2\u83b7\u7528\u6237\u76f4\u63a5\u6279\u51c6\u5e76\u5728A6000\u552f\u4e00\u63d0\u4ea4\uff0csource beb02c9\uff0csupervisor3929440\uff0frunner3929519\u73b0\u573a\u5b58\u6d3b\u521d\u59cb\u5316\u3002\u56db\u4e2a\u5df2\u6709CAL\u573a\u666f\uff0c\u6bcf\u573a\u666f\u6bd4\u8f83WC\u3001\u5171\u540c\u5237\u65b0\u3001RA\u3001\u5168\u5c40W1\u3001\u5168\u5c40\u03b2=1\u3001\u9636\u6bb5W1\u3001\u9636\u6bb5\u03b2=1\u4e03\u65b9\u6cd5\uff0c\u518d\u52a0\u56db\u4e2a\u539f\u751f\u53c2\u8003\uff0c\u51711152\u66f4\u65b0\uff0f2304CFG\u8c03\u7528\uff1b\u4fdd\u6301\u5168\u90e8\u5bf9\u7167\u3001\u62d2\u7edd\u548c\u5931\u8d25\uff0c\u4e0d\u62c6\u5361\u6216\u8865\u66ff\u6837\u672c\u3002\u9009\u5b9a\u751f\u4ea7CPU54.039325\u79d2exit0\u3001283\u8f7d\u8377\uff0f\u914d\u7f6e\uff0fruntime\u4e0e\u8bf7\u6c42\u6821\u9a8c\u53ca27\u53d8\u5f02\u62d2\u7edd\u901a\u8fc7\u3002GPU\u9000\u51fa\u540e\u7684\u771f\u5b9e\u539f\u4ef6\u5ba1\u8ba1\u5df2\u7ed1\u5b9apost CPU3929441\uff0c\u5168\u5e27\u8bc4\u5206CPU3930095\u4e5f\u5df2\u90e8\u7f72\u7b49\u5f85\u539fGPU\u4e0eraw CPU\u53e5\u67c4\uff1a\u5168\u90e8\u53ef\u914d\u5bf9\u89c6\u9891\u540493\u5e27\uff0c\u6700\u591a28\u5bf9\uff0f2604\u4e2a\u5e27\u8ddd\u79bb\u3001\u5341\u9879\u9884\u5b9a\u5bf9\u7167\u53ca32\u6210\u672c\u69fd\uff0c\u989d\u5916A\u5934\u5168\u90e8\u8ba1\u8d39\u3002\u6b63\u5728\u8fd0\u884c\u4e0d\u7b49\u4e8e\u5df2\u5f97\u5230\u65b9\u6cd5\u6536\u76ca\u3002\u6765\u6e90\u611f\u77e5\u9636\u6bb5\u666e\u901a\u91c7\u6837\u53e6\u5df2\u5b8c\u6210\u5e76\u72ec\u7acb\u9a8c\u6536\uff1asource12fe124\uff0f262\u8f7d\u8377\uff0c128\u6761\u5b8c\u657436\u6b65\uff0864\u6210\u529f\uff0b64\u672b\u5199\u51fa\u6545\u969c\uff09\u30012368\u5f20\u91cf\u91cd\u8bfb\u3001\u516bGEMM\u90e8\u5206\u8f68\u8ff9\u53c2\u7167\u3001512\u6062\u590d\u300116\u53d8\u5f02\u62d2\u7edd\uff0f\u4e24\u622a\u65ad\uff0f\u4e24\u672b\u5199\u51fa\u6545\u969c\uff1b\u539fRA/no-P\u4e0eCPD/A OFF\u5b8c\u6574\u8f68\u8ff9\u76f8\u540c\uff0c\u5b9e\u9645\u65e9\uff0f\u665aP\u4e3a480\uff0f280\uff0c\u51fa\u751ffloor\u4fdd\u6301\u3001\u53ea\u6709\u771f\u5b9eD\u91cd\u7f6e\u3002\u6b64CPU\u4f7f\u7528\u660e\u786esynthetic\u8d28\u91cf\u548c\u6210\u672c\u53c2\u6570\uff0c\u975eCosmos\u89c6\u9891\u6216\u771f\u5b9e\u901f\u5ea6\u3002\u65e7\u771f\u5b9eP0\u516b\u8d77\u70b948\u884c\uff0f144\u8ba1\u65f6\u53ca\u521b\u5efa\u9636\u6bb5\u6620\u5c04\u4fdd\u7559\uff1b\u4e0b\u4e00\u90e8\u5206\u5237\u65b0\u65b9\u6cd5\u8fd8\u9700\u540c\u72b6\u6001C/A/P/D\u5b9e\u9645\u589e\u91cf\u6210\u672c\u548c\u5b8c\u6574\u5019\u9009\u89c6\u9891\uff0c\u65e0\u975e\u5fc5\u8981\u4eba\u5de5\u8bc4\u5ba1\u3002\u63d0\u4ea4\u524d\u5b9e\u8017\u7d2f\u8ba134.372880296\uff0f77.895246590 GPUh\uff0c\u65b048\u7a97\u53e3\u4f5943.522366294\uff1b\u539f\u5361\u9884\u8ba15.147707517GPUh\u5df2\u5177\u4f53\u6279\u51c6\uff0c\u8d26\u672c\u5728\u9014\u9884\u7559\u5168\u90e8\u5269\u4f59\u662f\u5e76\u53d1\u4fdd\u62a4\uff0c\u4e0d\u662f\u9884\u7b97\u8017\u5c3d\uff0c\u7ec8\u6001\u6309\u5b9e\u8d39\u7ed3\u7b97\u3002\u5355\u6b21\u5b8c\u6574\u22644\u81ea\u4e3b\u3001\u4e25\u683c>4\u5177\u4f53\u786e\u8ba4\u89c4\u5219\u4fdd\u6301\u3002",
