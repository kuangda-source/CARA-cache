        },
        {
          "line": 498,
          "text": "        guidance: int = 7,"
        },
        {
          "line": 499,
          "text": "        num_video_frames: int = 77,"
        },
        {
          "line": 500,
          "text": "        num_latent_conditional_frames: int = 1,"
        },
        {
          "line": 501,
          "text": "        num_input_video: int = 1,"
        },
        {
          "line": 502,
          "text": "        num_output_video: int = 1,"
        },
        {
          "line": 503,
          "text": "        resolution: str = \"192,320\","
        },
        {
          "line": 504,
          "text": "        seed: int = 1,"
        },
        {
          "line": 505,
          "text": "        negative_prompt: str = _DEFAULT_NEGATIVE_PROMPT,"
        },
        {
          "line": 506,
          "text": "        camera: torch.Tensor | None = None,"
        },
        {
          "line": 507,
          "text": "        action: torch.Tensor | None = None,"
        },
        {
          "line": 508,
          "text": "        num_steps: int = 35,"
        },
        {
          "line": 509,
          "text": "    ):"
        },
        {
          "line": 510,
          "text": "        \"\"\""
        },
        {
          "line": 511,
          "text": "        Generates a video based on an input image or video and text prompt."
        },
        {
          "line": 512,
          "text": ""
        },
        {
          "line": 513,
          "text": "        Processes the input, prepares the data batch, runs the diffusion"
        },
        {
          "line": 514,
          "text": "        model sampling, and decodes the result into a video tensor."
        },
        {
          "line": 515,
          "text": ""
        },
        {
          "line": 516,
          "text": "        Args:"
        },
        {
          "line": 517,
          "text": "            prompt: The text prompt describing the desired video content/style."
        },
        {
          "line": 518,
          "text": "            input_path: Path to the input image or video file or a torch.Tensor."
        },
        {
          "line": 519,
          "text": "            guidance: Classifier-free guidance scale. Defaults to 7."
        },
        {
          "line": 520,
          "text": "            num_video_frames: Number of video frames to generate. Defaults to 77."
        },
        {
          "line": 521,
          "text": "            num_latent_conditional_frames : Number of latent conditional frames. Defaults to 1."
        },
        {
          "line": 522,
          "text": "            resolution: Target video resolution in \"H,W\" format. Defaults to \"192,320\"."
        },
        {
          "line": 523,
          "text": "            seed: Random seed for reproducibility. Defaults to 1."
        },
        {
          "line": 524,
          "text": "            negative_prompt: Custom negative prompt. Defaults to the predefined default negative prompt."
        },
        {
          "line": 525,
          "text": "            camera: Target camera extrinsics and intrinsics for the K output videos. Must be provided if model is camera conditioned."
        },
        {
          "line": 526,
          "text": "            action: Target robot action for the K output videos. Must be provided if model is action conditioned."
        },
        {
          "line": 527,
          "text": "            num_steps: Number of generation steps. Defaults to 35."
        },
        {
          "line": 528,
          "text": "            offload_diffusion_model: If True, offload diffusion model to CPU to save GPU memory. Defaults to False."
        },
        {
          "line": 529,
          "text": "            offload_text_encoder: If True, offload text encoder to CPU to save GPU memory. Defaults to False."
        },
        {
          "line": 530,
          "text": "            offload_tokenizer: If True, offload tokenizer to CPU to save GPU memory. Defaults to False."
        },
        {
          "line": 531,
          "text": ""
        },
        {
          "line": 532,
          "text": "        Returns:"
        },
        {
          "line": 533,
          "text": "            torch.Tensor: The generated video tensor (B, C, T, H, W) in the range [-1, 1]."
        },
        {
          "line": 534,
          "text": "        \"\"\""
        },
        {
          "line": 535,
          "text": "        assert camera is not None or action is not None or num_input_video == 1 and num_output_video == 1, ("
        },
        {
          "line": 536,
          "text": "            \"expected num_output_video==1 and num_output_video==1 for no camera conditioning or action conditioning\""
        },
        {
          "line": 537,
          "text": "        )"
        },
        {
          "line": 538,
          "text": ""
        },
        {
          "line": 706,
          "text": "        if isinstance(sample, list):"
        },
        {
          "line": 707,
          "text": "            # Decode the latent sample into a video tensor"
        },
        {
          "line": 708,
          "text": "            video_list = []"
        },
        {
          "line": 709,
          "text": "            for sample_chunk in sample:"
        },
        {
          "line": 710,
          "text": "                video_chunk = self.model.decode(sample_chunk)"
        },
        {
          "line": 711,
          "text": "                video_list.append(video_chunk)"
        },
        {
          "line": 712,
          "text": "            video = torch.cat(video_list, dim=3)"
        },
        {
          "line": 713,
          "text": "        else:"
        },
        {
          "line": 714,
          "text": "            # Decode the latent sample into a video tensor"
        },
        {
          "line": 715,
          "text": "            video = self.model.decode(sample)"
        },
        {
          "line": 716,
          "text": ""
        },
        {
          "line": 717,
          "text": "        # Memory Optimization Step 6: Final Cleanup"
        },
        {
          "line": 718,
          "text": "        # Offload decoder after decoding & reload the tokenizer for the next inference call"
        },
        {
          "line": 719,
          "text": "        if self.offload_tokenizer:"
        },
        {
          "line": 720,
          "text": "            log.info(\"[Memory Optimization] Offloading tokenizer decoder to CPU\")"
        },
        {
          "line": 721,
          "text": "            if hasattr(self.model.tokenizer, \"decoder\") and self.model.tokenizer.decoder is not None:"
        },
        {
          "line": 722,
          "text": "                self.model.tokenizer.decoder = self.model.tokenizer.decoder.to(\"cpu\")"
        },
        {
          "line": 723,
          "text": "            torch.cuda.empty_cache()"
        },
        {
          "line": 724,
          "text": ""
        },
        {
          "line": 725,
          "text": "        if self.offload_text_encoder and self.model.text_encoder is not None:"
        },
        {
          "line": 726,
          "text": "            log.info(\"[Memory Optimization] Load text encoder to GPU\")"
        },
        {
          "line": 727,
          "text": "            # TextEncoder is a wrapper class with self.model (the actual neural network)"
        },
        {
          "line": 728,
          "text": "            if hasattr(self.model.text_encoder, \"model\") and self.model.text_encoder.model is not None:"
        },
        {
          "line": 729,
          "text": "                self.model.text_encoder.model = self.model.text_encoder.model.to(\"cuda\")"
        },
        {
          "line": 730,
          "text": "            torch.cuda.empty_cache()"
        },
        {
          "line": 731,
          "text": ""
        },
        {
          "line": 732,
          "text": "        return video"
        },
        {
