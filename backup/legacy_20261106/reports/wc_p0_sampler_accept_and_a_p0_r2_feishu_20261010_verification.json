  "one_targeted_rich_paragraph_changed_all_other_content_preserved": true,
  "old_text": "P0\u90e8\u5206\u6765\u6e90\u590d\u7528\u4e0e\u8fde\u7eed\u66f4\u65b0\u5df2\u901a\u8fc7\u5b8c\u6574CPU\uff1a111.527233\u79d2\u3001\u4e09\u56fa\u5b9a\u5e8f\u5217\uff0f\u4e24flow\u517178\u5b8c\u657436\u6b65\u8def\u5f84\uff0f2886\u5f20\u91cf\u72ec\u7acb\u91cd\u8bfb\uff0c24\u72ec\u7acb\u90e8\u5206\u8f68\u8ff9\u53c2\u7167\u901a\u8fc7\uff1b\u65e726\u8def\u5f84\u7684guided\u548c\u7ec8\u70b9latent\u54c8\u5e0c\u5168\u90e8\u4e0e\u539f\u7248\u76f8\u540c\u3002230\u6b21P\u6765\u6e90\u7ee7\u7eedC\u300150\u6b21\u8fde\u7eedP\u30011520\u6b21\u9010\u5c42\uff0f\u5206\u652f\u6295\u5f71\u66f4\u65b0\u68c0\u67e5\u901a\u8fc7\uff1bP\u4fdd\u7559\u672a\u77e5\u8fd1\u4f3c\u8bef\u5dee\uff0cD-only\u5386\u53f2\u5206\u79bb\uff0c\u539f\u5939\u5177\u5931\u8d25\u4fdd\u6301\u3002\u8fd9\u662fToy\u5b8c\u6574\u7c7b\u4f53\u63a5\u7ebf\u8bc1\u636e\uff0c\u5c1a\u975eUniPC\uff0fCosmos\u5019\u9009\u89c6\u9891\u3002\u666e\u901aUniPC\uff0fguarded\u5b8c\u6574\u91c7\u6837\u4e0e\u989d\u5916\u6765\u6e90\u72b6\u6001\u6062\u590d\u5df2\u63a5\u5165\u5e76\u542f\u52a8\u72ec\u7acbCPU\u9a8c\u8bc1\uff1a\u56dbToy\u8bf7\u6c42\u300113\u65b9\u6cd5\u4e0e\u5bf9\u7167\u3001\u4e24flow\u5171104\u6210\u529f\u8def\u5f84\uff0c\u53e6\u5b8c\u6574104\u672b\u5199\u51fa\u6545\u969c\u8def\u5f84\uff1b\u5b8c\u6574208\u8def\u5f84\uff0f3848\u6210\u529f\u5f20\u91cf\u91cd\u8bfb\u5f85\u9a8c\u6536\uff0c\u4e0d\u7f29\u5bf9\u7167\u3002\u663e\u5f0fP\u8bed\u4e49A\uff0bP0\u7ec4\u5408\u6838\u5fc3\u5df2\u5199\u51fa\uff0c\u53ea\u901a\u8fc7AST\uff0c\u5c1a\u672aCPU\u9a8c\u6536\uff1bP\u7ed5\u8fc7\u65e7A\u7684D\u89c2\u5bdf\uff0cC\u4fee\u6b63\u4ecd\u8bfb\u53d6\u5b9e\u9645D-only\u5386\u53f2\u3002\u4e0b\u4e00\u5728\u5b8c\u6574\u91c7\u6837\u9a8c\u8bc1\u540e\u63a5\u7ec4\u5408\u6062\u590d\u3001\u6765\u6e90\u611f\u77e5W3\u4e0e\u771f\u5b9e\u89c6\u9891\uff1b\u4e0d\u8981\u6c42\u6a21\u5757\u5148\u72ec\u7acb\u8d62\u6240\u6709\u573a\u666f\uff0c\u66f4\u5e7fMLP\u8986\u76d6\u6216\u7ec4\u5408\u66f4\u65b0\u987b\u4e0b\u4e00\u8f6e\u524d\u77bb\u767b\u8bb0\uff0c\u4e0d\u589e\u52a0\u975e\u5fc5\u8981\u4eba\u8bc4\u3002",
  "new_text": "P0\u90e8\u5206\u6765\u6e90\u590d\u7528\u4e0e\u8fde\u7eed\u66f4\u65b0\u7684\u65e778\u8def\u5f84CPU\u7ed3\u679c\u53ca26\u8def\u5f84\u54c8\u5e0c\u56de\u5f52\u4fdd\u6301\u3002\u666e\u901aUniPC\uff0fguarded\u5b8c\u6574\u91c7\u6837\u4e0e\u989d\u5916\u6765\u6e90\u72b6\u6001\u6062\u590d\u73b0\u5df2\u901a\u8fc7\u72ec\u7acbCPU\u9a8c\u6536\uff1a1600.450405\u79d2\uff0c\u56dbToy\u8bf7\u6c42\uff0f13\u65b9\u6cd5\u4e0e\u63a7\u5236\uff0f\u4e24flow\u6210\u529f104\u8def\u5f84\uff0c\u53e6\u5b8c\u6574104\u672b\u5199\u51fa\u6545\u969c\u8def\u5f84\uff0c\u5171208\u00d736\uff1b\u5168\u90e83848\u6210\u529f\u5f20\u91cf\u53ca32\u72ec\u7acb\u90e8\u5206\u8f68\u8ff9\u53c2\u7167\u91cd\u8bfb\u3001416\u989d\u5916\uff0f\u7269\u7406\u72b6\u6001\u6270\u52a8\u6062\u590d\u300114\u53d8\u5f02\u4e0e\u4e24\u6587\u4ef6\u622a\u65ad\u62d2\u7edd\u901a\u8fc7\u3002360\u6b21P\u6765\u6e90\u7ee7\u7eedC\uff0f200\u6b21\u8fde\u7eedP\u68c0\u67e5\u4fdd\u6301\u5b9e\u9645D-only\u5386\u53f2\u3001P\u672a\u77e5\u6765\u6e90\u8bef\u5dee\u4e0e\u771f\u5b9e256\uff0f384\u884c\u90e8\u5206Linear\uff1b\u539f\u4e24\u6b2155\u79d2\u53ea\u8bfb\u6355\u83b7\u8d85\u65f6\u4fdd\u7559\uff0c\u540e\u7eed\u53ea\u8c03\u6574\u5ba1\u8ba1\u7ebf\u7a0b\uff0f\u975e\u963b\u585e\u89c2\u5bdf\uff0f\u65e0\u635f\u538b\u7f29\u5b8c\u6210\u590d\u6838\uff0c\u672a\u91cd\u8dd1\u539fCPU\u3002\u663e\u5f0fP\u8bed\u4e49A\uff0bP0\u5df2\u63a5\u666e\u901a\u5b8c\u6574\u91c7\u6837\u5e76\u7eb3\u5165A\u5386\u53f2\u6062\u590d\u3001\u771f\u5b9e\u539f\u5934\uff0b\u5019\u9009\u5934\u8ba1\u8d39\uff1b\u7ec4\u5408R1\u6f0f\u540c\u6b65\u5df2\u6709A\u6a21\u5757\uff0c\u5bfc\u5165\u5373\u505c\u30010\u751f\u6210\uff0c\u5931\u8d25\u5c01\u5b58\u3002R2\u8865\u9f50\u4f9d\u8d56\uff0c232\u8f7d\u8377\uff0f74\u6a21\u5757\u4f20\u9012\u4f9d\u8d56\u68c0\u67e5\u901a\u8fc7\uff0c\u4fdd\u6301\u539f13\u63a7\u5236\uff0b\u4e94A\u6a21\u5f0f\u3001\u56dbToy\u8bf7\u6c42\uff0f\u4e24flow\u5171288\u5b8c\u6574\u8def\u5f84\u30015328\u6210\u529f\u5f20\u91cf\u548c\u5168\u90e8\u6545\u969c\u63a7\u5236\uff0c\u539f\u76d1\u77633919183\uff0f\u5b503919184\u5df2\u542f\u52a8\u4e14\u73b0\u573a\u5b58\u6d3b\uff0c\u5b8c\u6574\u7ec8\u6001\u5f85\u9a8c\u6536\u3002P\u7ed5\u8fc7\u65e7A\u7684D\u89c2\u5bdf\uff0cC\u4fee\u6b63\u4ecd\u8bfb\u8fc7\u53bb\u5b9e\u9645D\uff0cA OFF\u987b\u5b8c\u6574\u7b49\u4ef7\u4e8e\u539fP0\u3002\u4ee5\u4e0a\u4e3aToy\u666e\u901a\u7ba1\u7ebf\u63a5\u7ebf\u4e0e\u6062\u590d\u8bc1\u636e\uff0c\u5c1a\u975eCosmos\u5019\u9009\u89c6\u9891\u3001\u771f\u5b9e\u8d28\u91cf\u6216\u52a0\u901f\uff1b\u4e0b\u4e00\u63a5\u6765\u6e90\u611f\u77e5W3\u4e0e\u5b8c\u6574\u89c6\u9891\uff0c\u4e0d\u8981\u6c42\u6a21\u5757\u5148\u72ec\u7acb\u8d62\u6240\u6709\u573a\u666f\uff0c\u66f4\u5e7f\u8986\u76d6\u6216\u7ec4\u5408\u66f4\u65b0\u5728\u4e0b\u4e00\u8f6e\u524d\u77bb\u767b\u8bb0\uff0c\u4e0d\u589e\u52a0\u975e\u5fc5\u8981\u4eba\u8bc4\u3002",
