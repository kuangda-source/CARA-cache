          },
          {
            "line": 44,
            "text": "        lower_order_final (`bool`, default `True`):"
          },
          {
            "line": 45,
            "text": "            Whether to use lower-order solvers in the final steps. Only valid for < 15 inference steps. This can"
          },
          {
            "line": 46,
            "text": "            stabilize the sampling of DPMSolver for steps < 15, especially for steps <= 10."
          },
          {
            "line": 47,
            "text": "        disable_corrector (`list`, default `[]`):"
          },
          {
            "line": 48,
            "text": "            Decides which step to disable the corrector to mitigate the misalignment between `epsilon_theta(x_t, c)`"
          },
          {
            "line": 49,
            "text": "            and `epsilon_theta(x_t^c, c)` which can influence convergence for a large guidance scale. Corrector is"
          },
          {
            "line": 50,
            "text": "            usually disabled during the first few steps."
          },
          {
            "line": 51,
            "text": "        solver_p (`SchedulerMixin`, default `None`):"
          },
          {
            "line": 52,
            "text": "            Any other scheduler that if specified, the algorithm becomes `solver_p + UniC`."
          },
          {
            "line": 53,
            "text": "        use_karras_sigmas (`bool`, *optional*, defaults to `False`):"
          },
          {
            "line": 54,
            "text": "            Whether to use Karras sigmas for step sizes in the noise schedule during the sampling process. If `True`,"
          },
          {
            "line": 55,
            "text": "            the sigmas are determined according to a sequence of noise levels {\u03c3i}."
          },
          {
            "line": 56,
            "text": "        use_exponential_sigmas (`bool`, *optional*, defaults to `False`):"
          },
          {
            "line": 222,
            "text": "    def _threshold_sample(self, sample: torch.Tensor) -> torch.Tensor:"
          },
          {
            "line": 223,
            "text": "        \"\"\""
          },
          {
            "line": 224,
            "text": "        \"Dynamic thresholding: At each sampling step we set s to a certain percentile absolute pixel value in xt0 (the"
          },
          {
            "line": 225,
            "text": "        prediction of x_0 at timestep t), and if s > 1, then we threshold xt0 to the range [-s, s] and then divide by"
          },
          {
            "line": 226,
            "text": "        s. Dynamic thresholding pushes saturated pixels (those near -1 and 1) inwards, thereby actively preventing"
          },
          {
            "line": 227,
            "text": "        pixels from saturation at each step. We find that dynamic thresholding results in significantly better"
          },
          {
            "line": 228,
            "text": "        photorealism as well as better image-text alignment, especially when using very large guidance weights.\""
          },
          {
            "line": 229,
            "text": ""
          },
          {
            "line": 230,
            "text": "        https://arxiv.org/abs/2205.11487"
          },
          {
            "line": 231,
            "text": "        \"\"\""
          },
          {
            "line": 232,
            "text": "        dtype = sample.dtype"
          },
          {
            "line": 233,
            "text": "        batch_size, channels, *remaining_dims = sample.shape"
          },
          {
            "line": 234,
            "text": ""
          },
          {
            "line": 235,
            "text": "        if dtype not in (torch.float32, torch.float64):"
          }
